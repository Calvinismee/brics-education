APP_NAME="Brics Education"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://brics-education.onrender.com
ASSET_URL=https://brics-education.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=error

# Supabase Postgres. Prefer Session Pooler for Laravel web services.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require

# Optional: use DATABASE_URL/DB_URL only if your hosting provider injects it.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
# DB_URL="${DATABASE_URL}"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Keep app default storage local; material uploads use R2 through the s3 disk.
FILESYSTEM_DISK=local
MATERIALS_FILESYSTEM_DISK=s3

# Cloudflare R2. AWS_URL must be a public bucket URL or custom public domain.
AWS_ACCESS_KEY_ID=R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=R2_BUCKET_NAME
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=https://PUBLIC_BUCKET_OR_CUSTOM_DOMAIN
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MIDTRANS_SERVER_KEY=Mid-server-PRODUCTION_OR_SANDBOX_KEY
MIDTRANS_CLIENT_KEY=Mid-client-PRODUCTION_OR_SANDBOX_KEY
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@bricseducation.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
